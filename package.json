{
	"name": "blastofeternity",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"og": "node scripts/og-images.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"puppeteer-core": "^25.9.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
