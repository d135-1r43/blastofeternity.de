{
	"name": "blastofeternity",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"og": "node scripts/og-images.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/qrcode": "^1.5.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"puppeteer-core": "^25.18.1",
		"qrcode": "^1.5.4",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
